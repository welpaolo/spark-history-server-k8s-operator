{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>canonical/data-platform//renovate_presets/charm.json5",
  ],
  "reviewers": ["team:processing"],
  // Between 1AM and 6:59AM, first Friday of the month
  "schedule": ["* 1-6 1-7 * 5"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 1-6 1-7 * 5"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^metadata\\.yaml$/"],
      "matchStrings": [
        "# 3\\.5-22\\.04_edge.*\\n\\s*upstream-source: ghcr\\.io/canonical/charmed-spark@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "depNameTemplate": "ghcr.io/canonical/charmed-spark",
      "currentValueTemplate": "3.5-22.04_edge",
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "# 3.5-22.04_edge, release date TBD\\n    upstream-source: ghcr.io/canonical/charmed-spark@{{{newDigest}}}"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["https://github.com/canonical/charmed-spark-rock/pkgs/container/charmed-spark"],
      "groupName": "charmed-spark-edge"
    }
  ],
  "ignoreDeps": ["ubuntu"]
}
