{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>canonical/data-platform//renovate_presets/charm.json5",
  ],
  "reviewers": ["team:processing"],
  // Between 1AM and 6:59AM, first Friday of the month
  "schedule": ["* 1-6 1-7 * 5"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 1-6 1-7 * 5"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^metadata\\.yaml$/"],
      "matchStrings": [
        "# (?<currentValue>\\d+\\.\\d+.*-22\\.04.*), release date .*\\n\\s*upstream-source: (?<depName>ghcr\\.io/canonical/charmed-spark)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "replacementStrings": [
        "# {{{newValue}}}, release date TBD (update manually)\n    upstream-source: {{{depName}}}@{{{newDigest}}}"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/canonical/charmed-spark"],
      "groupName": "charmed-spark",
      "schedule": ["* 1-6 1-7 * 5"],
      "minimumReleaseAge": "3 days"
    }
  ],
  "ignoreDeps": ["ubuntu"]
}
