 {
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>canonical/data-platform//renovate_presets/charm.json5"],
  "reviewers": ["team:processing"],
  "schedule": ["* 1-6 1-7 * 5"],
  "lockFileMaintenance": {"enabled": true, "schedule": ["* 1-6 1-7 * 5"]},
  "ignoreDeps": ["ubuntu"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^metadata\\.yaml$"],
      "matchStrings": [
        "# (?<currentValue>[^\\n]+)\\n\\s+upstream-source: (?<depName>[^@\\n]+)@sha256:(?<currentDigest>[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchDepNames": ["ghcr.io/canonical/charmed-spark"],
      "followTag": "3.5-22.04_edge",
      "pinDigests": true
    }
  ]
}
