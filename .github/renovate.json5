{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>canonical/data-platform//renovate_presets/charm.json5",
  ],
  "reviewers": ["team:processing"],
  // Between 1AM and 6:59AM, first Friday of the month
  "schedule": ["* 1-6 1-7 * 5"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 1-6 1-7 * 5"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^metadata\\.yaml$/"],
      "matchStrings": [
        "# (?<currentValue>3\\.5-22\\.04_edge), release date .*\\n\\s*upstream-source: (?<depName>ghcr\\.io/canonical/charmed-spark):(?<currentValue>3\\.5-22\\.04_edge)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "replacementStrings": [
        "# 3.5-22.04_edge, release date TBD (update manually)\n    upstream-source: {{{depName}}}:3.5-22.04_edge@{{{newDigest}}}"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/canonical/charmed-spark"],
      "allowedVersions": "3.5-22.04_edge",
      "groupName": "charmed-spark-edge",
      "schedule": ["* 1-6 1-7 * 5"]
    }
  ],
  "ignoreDeps": ["ubuntu"]
}
